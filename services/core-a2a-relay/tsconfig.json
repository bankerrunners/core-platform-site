{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "@cloudflare/workers-types"
    ],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src/**/*.ts"
  ]
}